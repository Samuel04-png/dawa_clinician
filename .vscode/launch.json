{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dawa (phone/tablet -> dawa.local hub)",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define=EDGE_DEVICE_BASE_URL=http://dawa.local",
        "--dart-define=EDGE_DEVICE_HUB_PORT=80",
        "--dart-define=EDGE_DEVICE_CERVICAL_PORT=8085",
        "--dart-define=EDGE_DEVICE_ULTRASOUND_PORT=8086",
        "--dart-define=EDGE_DEVICE_ANEMIA_PORT=8087",
        "--dart-define=EDGE_DEVICE_MODEL_MANAGEMENT_ENABLED=true",
        "--dart-define=EDGE_DEVICE_ULTRASOUND_INFERENCE_ENABLED=true"
      ]
    },
    {
      "name": "Dawa Web via dev proxy (start tool/edge_dev_proxy.dart first; prefer tool/run_web_dev.sh)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=5100",
        "--dart-define=EDGE_DEVICE_BASE_URL=http://localhost",
        "--dart-define=EDGE_DEVICE_HUB_PORT=8080",
        "--dart-define=EDGE_DEVICE_CERVICAL_PORT=8085",
        "--dart-define=EDGE_DEVICE_ULTRASOUND_PORT=8086",
        "--dart-define=EDGE_DEVICE_ANEMIA_PORT=8087",
        "--dart-define=EDGE_DEVICE_MODEL_MANAGEMENT_ENABLED=true",
        "--dart-define=EDGE_DEVICE_ULTRASOUND_INFERENCE_ENABLED=true"
      ]
    }
  ]
}
